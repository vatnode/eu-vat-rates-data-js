{
  "name": "eu-vat-rates-data",
  "version": "2026.8.23",
  "description": "Official-source European VAT rates for 45 jurisdictions. Daily-checked data, TypeScript types, offline JSON, and VAT number format validation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./data": "./data/eu-vat-rates-data.json"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test test.js"
  },
  "keywords": [
    "vat",
    "eu",
    "european-union",
    "tax",
    "rates",
    "europe",
    "vat-rates",
    "eu-vat",
    "vat-moss",
    "digital-services-tax",
    "billing",
    "e-commerce",
    "fintech",
    "invoice",
    "typescript",
    "json",
    "dataset",
    "tax-data",
    "sales-tax"
  ],
  "license": "MIT",
  "author": "Iurii Rogulia <iurii@rogulia.fi>",
  "homepage": "https://vatnode.dev/vat-rates?ref=rates-npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vatnode/eu-vat-rates-data-js.git"
  },
  "bugs": {
    "url": "https://github.com/vatnode/eu-vat-rates-data-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rogulia"
  }
}
